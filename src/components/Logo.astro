---
import { url } from '../i18n/site';
const { dark = false } = Astro.props;
---
<span class="flex items-center gap-3">
  <img src={url(dark ? '/img/dfs-logo-white-sm.png' : '/img/dfs-logo-black-sm.png')} alt="" width="52" height="43" class="h-11 w-auto" />
  <span class={`font-display text-[19px] font-extrabold uppercase leading-[0.95] ${dark ? 'text-paper' : 'text-ink'}`}>Delta Facilities<br />Solutions</span>
</span>
