---
import Logo from './Logo.astro';
import { t, routes, business, type Lang } from '../i18n/site';
const { lang, alt } = Astro.props as { lang: Lang; alt: string };
const d = t[lang].nav; const r = routes[lang];
const links = [
  { href: `${r.home}#services`, label: d.services },
  { href: `${r.home}#how`, label: d.how },
  { href: r.careers, label: d.careers },
  { href: `${r.home}#about`, label: d.about },
  { href: r.contact, label: d.contact },
];
---
<header class="sticky top-0 z-40 border-b-2 border-ink bg-paper">
  <div class="container-x flex h-[76px] items-center justify-between gap-6">
    <a href={r.home} aria-label={business.name}><Logo /></a>
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {links.map((l) => <a href={l.href} class="text-[15px] font-medium text-ink/75 underline-offset-8 hover:text-ink hover:underline">{l.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href={alt} lang={lang === 'en' ? 'fr' : 'en'} aria-label={d.switchLabel} class="rounded-xl border-2 border-ink px-3 py-1.5 text-xs font-bold hover:bg-ink hover:text-paper">{d.switch}</a>
      <a href={r.contact} class="btn-dark hidden !py-2.5 sm:inline-flex">{d.cta}</a>
      <details class="relative lg:hidden">
        <summary class="list-none cursor-pointer rounded-lg p-2 [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="absolute right-0 mt-3 w-64 rounded-2xl border-2 border-ink bg-paper p-2">
          {links.map((l) => <a href={l.href} class="block rounded-xl px-3 py-2.5 font-medium hover:bg-concrete">{l.label}</a>)}
          <a href={r.contact} class="btn-dark mt-1 w-full">{d.cta}</a>
        </div>
      </details>
    </div>
  </div>
</header>
