---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, business, url, type Lang } from '../i18n/site';

interface Props { lang: Lang; title?: string; description?: string; alt: string; }
const { lang, title, description, alt } = Astro.props;
const d = t[lang];
const pageTitle = title ? `${title} | ${business.name}` : d.meta.title;
const desc = description ?? d.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(url(alt), Astro.site);
const altLang = lang === 'en' ? 'fr' : 'en';
const ld = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', name: business.name,
  url: Astro.site?.toString(), email: business.email, foundingDate: String(business.founded), logo: new URL(url('/img/dfs-icon-512.png'), Astro.site).toString(),
  areaServed: ['Laval', 'Montréal'], description: t.en.meta.description,
};
---
<!doctype html>
<html lang={lang === 'fr' ? 'fr-CA' : 'en-CA'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'fr' ? 'fr-CA' : 'en-CA'} href={canonical} />
    <link rel="alternate" hreflang={altLang === 'fr' ? 'fr-CA' : 'en-CA'} href={altUrl} />
    <link rel="icon" href={url('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta property="og:image" content={new URL(url('/img/og.jpg'), Astro.site)} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Big+Shoulders+Display:wght@700;800;900&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-paper focus:px-4 focus:py-2">Skip to content</a>
    <Header lang={lang} alt={url(alt)} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
