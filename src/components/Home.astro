---
import Icon from './Icon.astro';
import DfsHero from '../islands/DfsHero.tsx';
import Faq from '../islands/Faq.tsx';
import { t, routes, business, url, type Lang } from '../i18n/site';
const { lang } = Astro.props as { lang: Lang };
const d = t[lang]; const r = routes[lang];
---
<DfsHero client:load
  headline={'Delta Facilities\nSolutions'}
  body={d.hero.lead}
  hint={d.hero.hint} hintTouch={d.hero.hintTouch}
  primary={{ label: d.hero.primary, href: r.contact }}
  secondary={{ label: d.hero.secondary, href: r.careers }}
  logoSrc={url('/img/dfs-sculpture.png')} />

<!-- What DFS takes off your hands -->
<section class="border-b-2 border-ink bg-concrete">
  <div class="container-x grid gap-px py-0 sm:grid-cols-3">
    {d.proof.map((p) => (
      <div class="py-8 sm:px-6 sm:first:pl-0">
        <p class="font-display text-3xl font-extrabold uppercase">{p.k}</p>
        <p class="mt-1 text-[15px] text-steel">{p.v}</p>
      </div>
    ))}
  </div>
</section>

<!-- Services: one row each, like the icon tiles on the DFS flyer -->
<section id="services" class="scroll-mt-20 py-20 md:py-28">
  <div class="container-x">
    <div class="grid gap-6 lg:grid-cols-[1fr_1.1fr] lg:items-end">
      <h2 class="display text-6xl sm:text-7xl">{d.services.title}</h2>
      <p class="max-w-xl text-lg text-steel lg:justify-self-end">{d.services.lead}</p>
    </div>
    <ul class="mt-14 border-t-2 border-ink">
      {d.services.items.map((s) => (
        <li class="group grid grid-cols-[auto_1fr] items-center gap-5 border-b-2 border-ink/10 py-6 transition-colors hover:border-ink sm:grid-cols-[auto_1fr_1.3fr] sm:gap-8">
          <span class="grid h-16 w-16 place-items-center rounded-2xl bg-ink text-paper transition-transform group-hover:-rotate-6">
            <Icon name={s.icon} class="h-8 w-8" />
          </span>
          <h3 class="font-display text-3xl font-extrabold uppercase leading-none sm:text-4xl">{s.title}</h3>
          <p class="col-span-2 text-[15px] leading-relaxed text-steel sm:col-span-1">{s.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- How it works: a real three-step sequence -->
<section id="how" class="scroll-mt-20 bg-ink py-20 text-paper md:py-28">
  <div class="container-x">
    <h2 class="display max-w-3xl text-6xl sm:text-7xl">{d.how.title}</h2>
    <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
      {d.how.steps.map((s, i) => (
        <li class="border-t-2 border-paper pt-6">
          <span class="font-display text-7xl font-black leading-none text-paper/30">{i + 1}</span>
          <h3 class="mt-4 font-sans text-xl font-bold">{s.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-paper/70">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Job seekers -->
<section class="py-20 md:py-28">
  <div class="container-x grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <h2 class="display text-6xl sm:text-7xl">{d.seekers.title}</h2>
      <p class="mt-6 max-w-lg text-lg text-steel">{d.seekers.body}</p>
      <a href={r.careers} class="btn-dark mt-8">{d.seekers.cta}<Icon name="arrow" class="h-4 w-4" /></a>
    </div>
    <ul class="space-y-3">
      {d.seekers.points.map((p) => (
        <li class="flex items-center gap-4 rounded-2xl border-2 border-ink p-5">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-ink text-paper"><Icon name="check" class="h-5 w-5" /></span>
          <span class="text-lg font-semibold">{p}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- About, with the real DFS flyer -->
<section id="about" class="scroll-mt-20 bg-concrete py-20 md:py-28">
  <div class="container-x grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:items-center">
    <div>
      <h2 class="display text-6xl sm:text-7xl">{d.about.title}</h2>
      <div class="mt-6 max-w-xl space-y-5 text-lg leading-relaxed text-graphite">
        <p>{d.about.body1}</p>
        <p>{d.about.body2}</p>
      </div>
    </div>
    <img src={url('/img/dfs-flyer.jpg')} alt="Delta Facilities Solutions flyer: warehousing, packaging, distribution and delivery" width="1144" height="1600"
      class="mx-auto w-full max-w-sm rotate-2 rounded-2xl border-2 border-ink" loading="lazy" />
  </div>
</section>

<!-- FAQ -->
<section class="py-20 md:py-28">
  <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.6fr]">
    <h2 class="display text-6xl sm:text-7xl">{d.faq.title}</h2>
    <Faq client:visible items={d.faq.items} />
  </div>
</section>

<!-- Closing call to action -->
<section class="bg-ink text-paper">
  <div class="container-x flex flex-col gap-8 py-16 md:flex-row md:items-end md:justify-between md:py-20">
    <div>
      <h2 class="display text-6xl sm:text-8xl">{d.ctaBand.title}</h2>
      <p class="mt-4 max-w-xl text-lg text-paper/70">{d.ctaBand.body}</p>
    </div>
    <a href={r.contact} class="btn-light shrink-0">{d.ctaBand.cta}</a>
  </div>
</section>
