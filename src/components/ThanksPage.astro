---
import { t, routes, type Lang } from '../i18n/site';
const { lang } = Astro.props as { lang: Lang };
const d = t[lang].thanks;
---
<section class="py-28">
  <div class="container-x max-w-xl text-center">
    <h1 class="display text-6xl text-ink">{d.title}</h1>
    <p class="mt-4 text-lg text-steel">{d.body}</p>
    <a href={routes[lang].home} class="btn-dark mt-8">{d.back}</a>
  </div>
</section>
