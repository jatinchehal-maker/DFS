---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { t, routes, business, type Lang } from '../i18n/site';
const { lang } = Astro.props as { lang: Lang };
const d = t[lang]; const r = routes[lang];
---
<footer class="bg-navy-950 text-white/80">
  <div class="container-x grid gap-10 py-14 md:grid-cols-3">
    <div>
      <Logo dark />
      <p class="mt-4 max-w-xs text-sm">{d.footer.tagline}</p>
    </div>
    <nav class="grid grid-cols-2 gap-2 text-sm" aria-label="Footer">
      <a href={`${r.home}#services`} class="hover:text-white">{d.nav.services}</a>
      <a href={`${r.home}#how`} class="hover:text-white">{d.nav.how}</a>
      <a href={r.careers} class="hover:text-white">{d.nav.careers}</a>
      <a href={`${r.home}#about`} class="hover:text-white">{d.nav.about}</a>
      <a href={r.contact} class="hover:text-white">{d.nav.contact}</a>
    </nav>
    <div class="space-y-3 text-sm">
      <a href={`mailto:${business.email}`} class="flex items-center gap-2 hover:text-white"><Icon name="mail" class="h-4 w-4" />{business.email}</a>
      {business.phone && <a href={`tel:${business.phone}`} class="flex items-center gap-2 hover:text-white"><Icon name="phone" class="h-4 w-4" />{business.phone}</a>}
      <p class="flex items-center gap-2"><Icon name="pin" class="h-4 w-4" />{business.area}</p>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="container-x py-5 text-xs text-white/60">© {new Date().getFullYear()} {business.name}. {d.footer.rights}</p>
  </div>
</footer>
