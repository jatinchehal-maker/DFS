---
import Logo from './Logo.astro';
import { t, routes, business, type Lang } from '../i18n/site';
const { lang, alt } = Astro.props as { lang: Lang; alt: string };
const d = t[lang].nav; const r = routes[lang];
const links = [
  { href: `${r.home}#services`, label: d.services },
  { href: `${r.home}#how`, label: d.how },
  { href: r.careers, label: d.careers },
  { href: `${r.home}#about`, label: d.about },
  { href: r.contact, label: d.contact },
];
---
<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="container-x flex h-[72px] items-center justify-between gap-6">
    <a href={r.home} aria-label={business.name}><Logo /></a>
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {links.map((l) => <a href={l.href} class="text-[15px] font-medium text-ink/80 hover:text-navy-900">{l.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href={alt} lang={lang === 'en' ? 'fr' : 'en'} aria-label={d.switchLabel} class="rounded-full border border-slate-300 px-3 py-1.5 text-xs font-bold text-navy-900 hover:border-navy-900">{d.switch}</a>
      <a href={r.contact} class="btn-dark hidden !py-2.5 sm:inline-flex">{d.cta}</a>
      <details class="relative lg:hidden">
        <summary class="list-none cursor-pointer rounded-lg p-2 text-navy-900 [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-60 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
          {links.map((l) => <a href={l.href} class="block rounded-lg px-3 py-2.5 font-medium hover:bg-sky-50">{l.label}</a>)}
          <a href={r.contact} class="btn-dark mt-2 w-full">{d.cta}</a>
        </div>
      </details>
    </div>
  </div>
</header>
