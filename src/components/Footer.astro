---
import Icon from './Icon.astro';
import { t, routes, business, url, type Lang } from '../i18n/site';
const { lang } = Astro.props as { lang: Lang };
const d = t[lang]; const r = routes[lang];
---
<footer class="bg-ink text-paper/75">
  <div class="container-x grid gap-10 py-16 md:grid-cols-[1.2fr_1fr_1fr]">
    <div class="flex items-start gap-5">
      <img src={url('/img/dfs-logo-white-sm.png')} alt="DFS, established 2022" width="120" height="98" class="h-24 w-auto" />
      <p class="max-w-xs text-sm leading-relaxed">{d.footer.tagline}</p>
    </div>
    <nav class="grid grid-cols-2 content-start gap-2 text-sm" aria-label="Footer">
      <a href={`${r.home}#services`} class="hover:text-paper">{d.nav.services}</a>
      <a href={`${r.home}#how`} class="hover:text-paper">{d.nav.how}</a>
      <a href={r.careers} class="hover:text-paper">{d.nav.careers}</a>
      <a href={`${r.home}#about`} class="hover:text-paper">{d.nav.about}</a>
      <a href={r.contact} class="hover:text-paper">{d.nav.contact}</a>
    </nav>
    <div class="space-y-3 text-sm">
      <a href={`tel:${business.phoneHref}`} class="flex items-center gap-2 font-semibold text-paper hover:underline"><Icon name="phone" class="h-4 w-4" />{business.phone}</a>
      <a href={`mailto:${business.email}`} class="flex items-center gap-2 break-all hover:text-paper"><Icon name="mail" class="h-4 w-4 shrink-0" />{business.email}</a>
      <p class="flex items-center gap-2"><Icon name="pin" class="h-4 w-4 shrink-0" />{business.area}</p>
    </div>
  </div>
  <div class="border-t border-paper/15">
    <p class="container-x py-5 text-xs text-paper/50">© {new Date().getFullYear()} {business.name}. {d.footer.rights}</p>
  </div>
</footer>
